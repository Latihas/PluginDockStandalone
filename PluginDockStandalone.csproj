<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<OutputPath>bin</OutputPath>
		<Version>7.57.0.1</Version>
		<Name>PluginDock</Name>
		<Author>Latihas, Shiyuvi</Author>
		<Punchline>简单的插件/指令收纳</Punchline>
		<Tags>ui;dock;utility</Tags>
		<category_tags>ui;utilities</category_tags>
		<Description>把其他插件的主界面/设置入口或是指令收纳到悬浮图标栏里</Description>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == ''">
		<DalamudLibPath>$(appdata)\XIVLauncherCN\addon\Hooks\dev</DalamudLibPath>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
	</PropertyGroup>
</Project>
